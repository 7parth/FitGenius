# ── Copy this file to .env and fill in real values ───────────────────────────
# NEVER commit .env to version control.

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=FitGenius API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=fitgenius
POSTGRES_PASSWORD=fitgenius_dev_password
POSTGRES_DB=fitgenius
DATABASE_URL=postgresql://fitgenius:fitgenius_dev_password@db:5432/fitgenius

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Comma-separated if multiple origins needed in dev
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── OpenAI — SERVER SIDE ONLY, never expose to frontend ──────────────────────
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o-mini

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_LOGIN=10/minute

# ── ML model ─────────────────────────────────────────────────────────────────
ML_MODEL_PATH=models/recommendation_model.pkl

# ── Vite / Frontend (only needed for frontend container) ─────────────────────
VITE_API_BASE_URL=http://localhost:8000
