# ── Copy this file to .env and fill in real values ───────────────────────────
# NEVER commit .env to version control.

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=FitGenius API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# ── Supabase PostgreSQL — required ────────────────────────────────────────────
# Copy the Session pooler URI from Supabase Dashboard > Connect.
# URL-encode special characters in the password (for example, @ becomes %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<URL-ENCODED-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Comma-separated if multiple origins needed in dev
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Groq / LangChain — SERVER SIDE ONLY, never expose to frontend ─────────────
GROQ_API_KEY=gsk_...your-groq-key-here...
GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenAI fallback — SERVER SIDE ONLY, never expose to frontend ──────────────
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o-mini

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_LOGIN=10/minute

# ── ML model ─────────────────────────────────────────────────────────────────
ML_MODEL_PATH=models/recommendation_model.pkl

# ── Vite / Frontend (only needed for frontend container) ─────────────────────
VITE_API_BASE_URL=http://localhost:8000
